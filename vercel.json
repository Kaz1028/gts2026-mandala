{
  "version": 2,
  "builds": [
    { "src": "index.html",  "use": "@vercel/static" },
    { "src": "team.html",   "use": "@vercel/static" },
    { "src": "admin.html",  "use": "@vercel/static" },
    { "src": "fxtest.html", "use": "@vercel/static" },
    { "src": "noto-emoji.js", "use": "@vercel/static" },
    { "src": "emoji/*.svg", "use": "@vercel/static" },
    { "src": "fx/*.js",     "use": "@vercel/static" },
    { "src": "sfx/*.mp3",   "use": "@vercel/static" },
    { "src": "api/setup.js",           "use": "@vercel/node" },
    { "src": "api/auth-login.js",      "use": "@vercel/node" },
    { "src": "api/auth-me.js",         "use": "@vercel/node" },
    { "src": "api/team-mandala.js",    "use": "@vercel/node" },
    { "src": "api/team-submit.js",     "use": "@vercel/node" },
    { "src": "api/team-upload.js",     "use": "@vercel/node" },
    { "src": "api/admin-teams.js",     "use": "@vercel/node" },
    { "src": "api/admin-team-num.js",  "use": "@vercel/node" },
    { "src": "api/admin-benefit.js",   "use": "@vercel/node" },
    { "src": "api/admin-benefit-id.js","use": "@vercel/node" },
    { "src": "api/admin-reset.js",    "use": "@vercel/node" },
    { "src": "api/admin-delete-team.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/setup",              "dest": "/api/setup.js" },
    { "src": "/api/auth/login",         "dest": "/api/auth-login.js" },
    { "src": "/api/auth/me",            "dest": "/api/auth-me.js" },
    { "src": "/api/team/mandala",       "dest": "/api/team-mandala.js" },
    { "src": "/api/team/submit",        "dest": "/api/team-submit.js" },
    { "src": "/api/team/upload",        "dest": "/api/team-upload.js" },
    { "src": "/api/admin/teams",        "dest": "/api/admin-teams.js" },
    { "src": "/api/admin/team/([^/]+)", "dest": "/api/admin-team-num.js?num=$1" },
    { "src": "/api/admin/benefit/([^/]+)", "dest": "/api/admin-benefit-id.js?id=$1" },
    { "src": "/api/admin/benefit",      "dest": "/api/admin-benefit.js" },
    { "src": "/api/admin/reset",        "dest": "/api/admin-reset.js" },
    { "src": "/api/admin/delete-team",  "dest": "/api/admin-delete-team.js" },
    { "src": "/noto-emoji.js", "dest": "/noto-emoji.js" },
    { "src": "/emoji/(.*)", "dest": "/emoji/$1" },
    { "src": "/fx/(.*)",    "dest": "/fx/$1" },
    { "src": "/sfx/(.*)",   "dest": "/sfx/$1" },
    { "src": "/fxtest.html", "dest": "/fxtest.html" },
    { "src": "/team.html",  "dest": "/team.html" },
    { "src": "/admin.html", "dest": "/admin.html" },
    { "src": "/",           "dest": "/index.html" }
  ]
}
