# Copy to .env.local for local development. Never commit actual values.
# Generate independent random values: JWT_SECRET >= 32, ADMIN_PASSWORD >= 16 characters.
JWT_SECRET=
ADMIN_ID=admin
ADMIN_PASSWORD=
# Optional initial teams. Keep real passwords in server environment variables only.
# Each entry: {"team_number":1,"password":"<independently generated password>"}
# Vercel: team numbers 1 through event.config.js teamCount. Existing teams are never updated by setup.
TEAM_CREDENTIALS_JSON=[]
POSTGRES_URL=
BLOB_READ_WRITE_TOKEN=
