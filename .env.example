# Copy to .env.local for local development. Never commit actual values.
# Generate independent random values: JWT_SECRET >= 32, ADMIN_PASSWORD >= 16 characters.
JWT_SECRET=
ADMIN_ID=admin
ADMIN_PASSWORD=
# Teams log in by choosing their number (no team passwords). Setup creates teams 1..teamCount.
POSTGRES_URL=
BLOB_READ_WRITE_TOKEN=
